{
  "name": "codex-profile-switcher",
  "displayName": "Codex Profile Switcher",
  "description": "Switch Codex auth.json between multiple local profiles.",
  "version": "0.0.1",
  "publisher": "luccasoliva",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luccasoliva/codex-profile-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/luccasoliva/codex-profile-switcher/issues"
  },
  "homepage": "https://github.com/luccasoliva/codex-profile-switcher#readme",
  "keywords": [
    "codex",
    "openai",
    "profile",
    "switcher",
    "auth",
    "vscode"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onView:codexProfilesView",
    "onCommand:codexProfiles.add",
    "onCommand:codexProfiles.switch",
    "onCommand:codexProfiles.showActive",
    "onCommand:codexProfiles.openStorage",
    "onCommand:codexProfiles.reloadWindow",
    "onCommand:codexProfiles.remove",
    "onCommand:codexProfiles.refreshView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexProfilesContainer",
          "title": "Codex Switcher",
          "icon": "media/codex-switcher.svg"
        }
      ]
    },
    "views": {
      "codexProfilesContainer": [
        {
          "type": "webview",
          "id": "codexProfilesView",
          "name": "Profiles"
        }
      ]
    },
    "commands": [
      {
        "command": "codexProfiles.add",
        "title": "Codex Profiles: Add Profile",
        "icon": "$(add)"
      },
      {
        "command": "codexProfiles.switch",
        "title": "Codex Profiles: Switch Profile",
        "icon": ""
      },
      {
        "command": "codexProfiles.showActive",
        "title": "Codex Profiles: Show Active Profile",
        "icon": "$(eye)"
      },
      {
        "command": "codexProfiles.openStorage",
        "title": "Codex Profiles: Open Storage Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codexProfiles.reloadWindow",
        "title": "Codex Profiles: Reload VS Code Window",
        "icon": "$(refresh)"
      },
      {
        "command": "codexProfiles.remove",
        "title": "Codex Profiles: Remove Saved Profile",
        "icon": "$(trash)"
      },
      {
        "command": "codexProfiles.refreshView",
        "title": "Codex Profiles: Refresh View",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Codex Profile Switcher",
      "properties": {
        "codexProfileSwitcher.codexHome": {
          "type": "string",
          "default": "",
          "description": "Codex home path. Defaults to ~/.codex."
        },
        "codexProfileSwitcher.switcherHome": {
          "type": "string",
          "default": "",
          "description": "Switcher storage path. Defaults to ~/.codex-switcher."
        },
        "codexProfileSwitcher.promptReloadAfterSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Ask to reload VS Code after switching Codex profile."
        },
        "codexProfileSwitcher.autoUseNewProfile": {
          "type": "boolean",
          "default": false,
          "description": "Automatically activate newly added Codex profile after login."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}